# GEMINI_API_KEY: Required for server-side Gemini AI Assistant calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: Set AI_PROVIDER="anthropic" and ANTHROPIC_API_KEY to use Claude instead of Gemini.
AI_PROVIDER="gemini"
ANTHROPIC_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Rate limiting configuration (requests per window)
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_AQI_MAX="60"
RATE_LIMIT_CHAT_MAX="20"
